<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link
      rel="stylesheet"
      href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
    />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <link
      rel="stylesheet"
      href="https://unpkg.com/leaflet-routing-machine/dist/leaflet-routing-machine.css"
    />
    <script src="https://unpkg.com/leaflet-routing-machine/dist/leaflet-routing-machine.js"></script>
    <title>Document</title>
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: Arial, sans-serif;
      }

      header {
        background-color: #2c3e50;
        color: white;
        padding: 12px 20px;
      }

      .logo {
        font-size: 20px;
        font-weight: bold;
        margin-bottom: 10px;
      }

      #filters {
        display: flex;
        gap: 15px;
        align-items: center;
        flex-wrap: wrap;
      }

      #filters label {
        display: flex;
        align-items: center;
        gap: 5px;
        font-size: 14px;
      }

      #cacloaixang,
      #cacdichvu,
      #cacthuonghieu {
        display: flex;
        gap: 8px;
        align-items: center;
      }

      select {
        padding: 5px 10px;
        border-radius: 4px;
        border: none;
        font-size: 14px;
      }

      #filter-btn {
        background-color: #e74c3c;
        color: white;
        padding: 6px 18px;
        border: none;
        border-radius: 4px;
        cursor: pointer;
        font-size: 14px;
      }

      #filter-btn:hover {
        background-color: #c0392b;
      }

      .container {
        display: flex;
        height: calc(100vh - 95px);
      }

      #map {
        width: 75%;
        height: 100%;
      }

      #list-container {
        width: 25%;
        overflow-y: auto;
        padding: 20px;
        border-left: 2px solid #ddd;
      }

      .station-item {
        padding: 15px;
        border-bottom: 1px solid #eee;
        cursor: pointer;
      }

      .station-item:hover {
        background-color: #f5f5f5;
      }

      .station-name {
        font-weight: bold;
        font-size: 16px;
        margin-bottom: 5px;
      }

      .station-info {
        color: #666;
        font-size: 14px;
      }

      .route-info-tooltip {
        background: #1e90ff;
        color: white;
        padding: 6px 10px;
        border-radius: 8px;
        font-size: 14px;
        font-weight: bold;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.3);
      }
    </style>
  </head>
  <body>
    <header>
      <div class="logo">⛽ Tìm Kiếm Cây Xăng</div>
      <div id="filters">
        <label><input type="checkbox" id="nearby" /> Gần Bạn (<2km) </label>
        <div id="cacloaixang">
          <label>Loại xăng</label>
          <select id="loaixang">
            <option value="">Tất cả</option>
            <option value="xang92">Xăng RON 92</option>
            <option value="xang95">Xăng RON 95</option>
            <option value="daudiesel">Dầu diesel</option>
            <option value="dauhoa">Dầu hỏa</option>
          </select>
        </div>
        <div id="cacdichvu">
          <label>Dịch vụ</label>
          <select id="dichvu">
            <option value="">Tất cả</option>
            <option value="tramsacxedien">Trạm sạc xe điện</option>
            <option value="ruaxe">Rửa xe</option>
            <option value="nhavesinh">Nhà vệ sinh</option>
          </select>
        </div>
        <div id="cacthuonghieu">
          <label>Thương hiệu</label>
          <select id="thuonghieu">
            <option value="">Tất cả</option>
            <option value="tunhan">Cây xăng tư nhân</option>
            <option value="mipec">Cây xăng quân đội MIPEC</option>
            <option value="petrolimex">Cây xăng nhà nước Petrolimex</option>
            <option value="pvoil">Cây xăng nhà nước PVOIL</option>
          </select>
        </div>
        <button id="filter-btn"><strong>Tìm kiếm</strong></button>
      </div>
    </header>

    <div class="container">
      <div id="map"></div>
      <div id="list-container">
        <div id="station-list"></div>
      </div>
    </div>

    <script src="/js/script.js"></script>
  </body>
</html>
