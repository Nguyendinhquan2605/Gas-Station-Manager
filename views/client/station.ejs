<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link
      rel="stylesheet"
      href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
    />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <link
      rel="stylesheet"
      href="https://unpkg.com/leaflet-routing-machine/dist/leaflet-routing-machine.css"
    />
    <script src="https://unpkg.com/leaflet-routing-machine/dist/leaflet-routing-machine.js"></script>
    <title><%= pageTitle %></title>
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: Arial, sans-serif;
      }

      header {
        background-color: #2c3e50;
        color: white;
        padding: 12px 20px;
      }

      .logo {
        font-size: 20px;
        font-weight: bold;
        margin-bottom: 10px;
      }

      #filters {
        display: flex;
        gap: 15px;
        align-items: center;
        flex-wrap: wrap;
      }

      #filters label {
        display: flex;
        align-items: center;
        gap: 5px;
        font-size: 14px;
      }

      #cacloaixang,
      #cacdichvu,
      #cacthuonghieu {
        display: flex;
        gap: 8px;
        align-items: center;
      }

      select {
        padding: 5px 10px;
        border-radius: 4px;
        border: none;
        font-size: 14px;
      }

      #filter-btn {
        background-color: #e74c3c;
        color: white;
        padding: 6px 18px;
        border: none;
        border-radius: 4px;
        cursor: pointer;
        font-size: 14px;
      }

      #filter-btn:hover {
        background-color: #c0392b;
      }

      .container {
        display: flex;
        height: calc(100vh - 95px);
      }

      /* Map chiếm 70% */
      #map {
        flex: 3;
        height: 100%;
      }

      /* Danh sách chiếm 30% */
      #list-container {
        flex: 1;
        overflow-y: auto;
        border-left: 1px solid #ddd;
        background: #fff;
      }

      /* Từng item cây xăng */
      .station-item {
        padding: 12px;
        border-bottom: 1px solid #eee;
        cursor: pointer;
      }

      .station-item:hover {
        background: #f5f5f5;
      }

      .station-name {
        font-weight: bold;
        font-size: 16px;
        margin-bottom: 5px;
      }

      .station-info {
        color: #666;
        font-size: 14px;
      }

      .station-title {
        font-weight: bold;
        font-size: 16px;
      }

      .station-address {
        font-size: 14px;
        color: #444;
      }

      .view-map-btn {
        margin-top: 6px;
        padding: 6px 10px;
        background: #2a7ae4;
        color: white;
        border: none;
        border-radius: 4px;
        cursor: pointer;
      }

      .view-map-btn:hover {
        background: #1e5fb8;
      }

      .route-info-tooltip {
        background: #1e90ff;
        color: white;
        padding: 6px 10px;
        border-radius: 8px;
        font-size: 14px;
        font-weight: bold;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.3);
      }
      .clear-route-btn {
        position: absolute;
        top: 20px;
        right: 20px;
        z-index: 9999;
        background: #ff4444;
        color: white;
        border: none;
        padding: 8px 14px;
        border-radius: 6px;
        cursor: pointer;
        font-size: 14px;
      }
    </style>
  </head>
  <body>
    <header>
      <div class="logo">⛽ Tìm Kiếm Cây Xăng</div>
      <div id="filters">
        <label><input type="checkbox" id="nearby" /> Cây xăng gần đây </label>
        <div id="cacloaixang">
          <label>Loại nhiên liệu</label>
          <select id="loaixang" name="brand_id">
            <option value="">Tất cả</option>
            <% fuelTypes.forEach(fuel => { %>
            <option value="<%= fuel.id %>"><%= fuel.fuel_name %></option>
            <% } ) %>
          </select>
        </div>

        <div id="cacthuonghieu">
          <label>Thương hiệu</label>
          <select id="thuonghieu">
            <option value="">Tất cả</option>
            <% brands.forEach(brand => { %>
            <option value="<%= brand.id %>"><%= brand.name %></option>
            <% } ) %>
          </select>
        </div>
        <button id="filter-btn"><strong>Tìm kiếm</strong></button>
      </div>
    </header>

    <div class="container">
      <button
        id="clear-route-btn"
        class="clear-route-btn"
        style="display: none"
      >
        ❌ Tắt chỉ đường
      </button>

      <div id="map"></div>
      <div id="list-container">
        <div id="station-list"></div>
      </div>
    </div>

    <script src="/js/script.js"></script>
  </body>
</html>
