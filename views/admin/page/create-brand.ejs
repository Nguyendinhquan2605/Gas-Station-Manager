<% layout('admin/layouts/default') %>

<div class="page-container">
  <div class="page-header">
    <h1 class="page-title">⛽ Thêm mới thương hiệu</h1>
  </div>

  <div class="form-container">
    <div id="successMessage" class="success-message">
      ✓ Thêm thương hiệu thành công!
    </div>

    <form id="brandForm" method="post" action="/admin/brands/create-brand">
      <!-- Tên thương hiệu -->
      <div class="form-group">
        <label for="name">Tên cây xăng <span class="required">*</span></label>
        <input
          type="text"
          id="name"
          name="name"
          placeholder="VD: Petrolimex"
          required
        />
      </div>

      <!-- Buttons -->
      <div class="button-group">
        <button type="submit" class="btn-submit">Thêm thương hiệu</button>
        <button type="reset" class="btn-reset">Làm Mới</button>
      </div>
    </form>
  </div>
</div>
