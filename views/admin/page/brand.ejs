<% layout('admin/layouts/default') %>

<div class="page-container">
  <div class="page-header">
    <h1 class="page-title">⛽ Danh sách Thương hiệu</h1>
    <a href="/admin/brands/create-brand" class="btn-add">+ Thêm mới</a>
  </div>

  <div class="table-container">
    <table class="data-table">
      <thead>
        <tr>
          <th>STT</th>
          <th>Tên Thương hiệu</th>
          <th>Hành động</th>
        </tr>
      </thead>
      <tbody>
        <% brands.forEach((brand,index) => { %>
        <tr>
          <td><%= index + 1 %></td>
          <td><%= brand.name %></td>
          <td>
            <div class="action-buttons">
              <a href="/admin/brands/edit/<%= brand.id %>" class="btn-edit"
                >Sửa</a
              >
              <button
                class="btn-delete"
                button-delete-brand
                button-id="<%= brand.id %>"
              >
                Xóa
              </button>
            </div>
          </td>
        </tr>
        <% } ) %>
      </tbody>
    </table>
  </div>
</div>
