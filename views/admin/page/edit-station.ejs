<% layout('admin/layouts/default') %>

<div class="page-container">
  <div class="page-header">
    <h1 class="page-title">⛽ Chỉnh sửa cây xăng</h1>
  </div>

  <div class="form-container">
    <div id="successMessage" class="success-message">
      ✓ Thêm cây xăng thành công!
    </div>

    <form id="gasStationForm" method="post" action="/admin/create-station">
      <!-- Tên cây xăng -->
      <div class="form-group">
        <label for="name">Tên cây xăng <span class="required">*</span></label>
        <input
          type="text"
          id="name"
          name="name"
          value="<%= station.name %>"
          placeholder="VD: Cây xăng Petrolimex Hà Nội"
          required
        />
      </div>

      <!-- Lat & Lng -->
      <div class="form-row">
        <div class="form-group">
          <label for="lat">Latitude <span class="required">*</span></label>
          <input
            type="number"
            id="lat"
            name="lat"
            step="any"
            value="<%= station.lat %>"
            placeholder="21.0285"
            required
          />
        </div>
        <div class="form-group">
          <label for="lng">Longitude <span class="required">*</span></label>
          <input
            type="number"
            id="lng"
            name="lng"
            step="any"
            value="<%= station.lng %>"
            placeholder="105.8542"
            required
          />
        </div>
      </div>

      <!-- Địa chỉ -->
      <div class="form-group">
        <label for="address">Địa chỉ <span class="required">*</span></label>
        <textarea
          id="address"
          name="address"
          placeholder="VD: 123 Phố Huế, Hai Bà Trưng, Hà Nội"
          required
        ><%= station.address %></textarea>
      </div>

      <!-- Phone -->
      <div class="form-group">
        <label for="phone">Số điện thoại <span class="required">*</span></label>
        <input
          type="text"
          id="phone"
          name="phone"
          value="<%= station.phone %>"
          placeholder="0123456789"
          required
        />
      </div>

      <!-- Giờ mở cửa -->
      <div class="form-group">
        <label for="openingHours"
          >Giờ mở cửa <span class="required">*</span></label
        >
        <input
          type="text"
          id="hours"
          name="hours"
          value="<%= station.hours %>"
          placeholder="VD: 06:00 - 22:00 hoặc 24/7"
          required
        />
      </div>

      <!-- Thương hiệu -->
      <div class="form-group">
        <label for="brand">Thương hiệu <span class="required">*</span></label>
        <select id="brand" name="brand_id" required>
          <option value="" disabled selected>---Chọn thương hiệu---</option>
          <% brands.forEach(brand => { %>
          <option value="<%= brand.id %>" <%= brand.id === station.brand_id ? "selected" : "" %> ><%= brand.name %></option>
          <% } ) %>
        </select>
      </div>

      <!-- Services -->
      <div class="form-group">
        <label for="services">Dịch vụ</label>
        <input
          type="text"
          id="services"
          name="services"
          value="<%= station.services %>"
          placeholder="VD: Rửa xe, Cửa hàng tiện lợi, ATM"
        />
      </div>

      <!-- Loại nhiên liệu -->
      <% fuelTypes.forEach(ft => { %>
      <div class="checkbox-item">
        <input
            type="checkbox"
            id="fuel-<%= ft.id %>"
            name="fuel_id[]"
            value="<%= ft.id %>"

            <% if (selectedFuelIds.includes(ft.id)) { %>
            checked
            <% } %>
        />
        <label for="fuel-<%= ft.id %>"><%= ft.fuel_name %></label>
      </div>
      <% }) %>

      <!-- Buttons -->
      <div class="button-group">
        <button type="submit" class="btn-submit">Chỉnh sửa</button>
        <button type="reset" class="btn-reset"><a style="text-decoration: none; color: white;" href="/admin/Alls-stations">Quay lại</a></button>
      </div>
    </form>
  </div>
</div>
