<% layout('admin/layouts/default') %>

<div class="page-container">
  <div class="page-header">
    <h1 class="page-title">⛽ Chỉnh sửa nhiên liệu</h1>
  </div>

  <div class="form-container">
    <div id="successMessage" class="success-message">
      ✓ Sửa nhiên liệu thành công!
    </div>

    <form
      id="fuelForm"
      data-action="/admin/fuel_types/edit/<%= fuel_type.id %>"
    >
      <!-- Tên nhiên liệu -->
      <div class="form-group">
        <label for="name">Tên nhiên liệu <span class="required">*</span></label>
        <input
          type="text"
          id="name"
          name="name"
          value="<%= fuel_type.fuel_name %>"
          required
        />
      </div>

      <!-- Buttons -->
      <div class="button-group">
        <button type="submit" class="btn-submit">Chỉnh sửa</button>
        <button type="reset" class="btn-reset">
          <a
            style="text-decoration: none; color: white"
            href="/admin/fuel_types"
            >Quay lại</a
          >
        </button>
      </div>
    </form>
  </div>
</div>
