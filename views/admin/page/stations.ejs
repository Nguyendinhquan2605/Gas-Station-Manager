<% layout('admin/layouts/default') %>

<div class="page-container">
  <div class="page-header">
    <h1 class="page-title">⛽ Danh sách cây xăng</h1>
  </div>

  <div class="table-container">
    <table class="data-table">
      <thead>
        <tr>
          <th>STT</th>
          <th>Tên cây xăng</th>
          <th>Phone</th>
          <th>Thương hiệu</th>
          <th>Hành động</th>
        </tr>
      </thead>
      <tbody>
        <% stations.forEach((station,index) => { %>
        <tr>
          <td><%= index + 1 %></td>
          <td><%= station.name %></td>
          <td><%= station.phone %></td>
          <td><%= station.brand.name %></td>
          <td>
            <div class="action-buttons">
              <a href="/admin/stations/edit/<%= station.id %>" class="btn-edit"
                >Sửa</a
              >
              <button class="btn-delete">Xóa</button>
            </div>
          </td>
        </tr>
        <% } ) %>
      </tbody>
    </table>
  </div>
</div>
