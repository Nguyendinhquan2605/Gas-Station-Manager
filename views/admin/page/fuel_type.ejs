<% layout('admin/layouts/default') %>

<div class="page-container">
  <div class="page-header">
    <h1 class="page-title">⛽ Danh sách Nhiên liệu</h1>
    <a href="/admin/fuel_types/create-fuel" class="btn-add">+ Thêm mới</a>
  </div>

  <div class="table-container">
    <table class="data-table">
      <thead>
        <tr>
          <th>STT</th>
          <th>Tên Nhiên liệu</th>
          <th>Hành động</th>
        </tr>
      </thead>
      <tbody>
        <% fuel_types.forEach((fuel,index) => { %>
        <tr>
          <td><%= index + 1 %></td>
          <td><%= fuel.fuel_name %></td>
          <td>
            <div class="action-buttons">
              <a href="/admin/fuel_types/edit/<%= fuel.id %>" class="btn-edit"
                >Sửa</a
              >
              <button
                class="btn-delete"
                button-delete-fuel
                button-id="<%= fuel.id %>"
              >
                Xóa
              </button>
            </div>
          </td>
        </tr>
        <% } ) %>
      </tbody>
    </table>
  </div>
</div>
