<% layout('admin/layouts/default') %>

<div class="page-container">
  <div class="page-header">
    <h1 class="page-title">⛽ Chỉnh sửa thương hiệu</h1>
  </div>

  <div class="form-container">
    <div id="successMessage" class="success-message">
      ✓ Thêm cây xăng thành công!
    </div>

    <form id="brandForm" data-action="/admin/brands/edit/<%= brand.id %>">
      <!-- Tên thương hiệu -->
      <div class="form-group">
        <label for="name"
          >Tên thương hiệu <span class="required">*</span></label
        >
        <input
          type="text"
          id="name"
          name="name"
          value="<%= brand.name %>"
          required
        />
      </div>

      <!-- Buttons -->
      <div class="button-group">
        <button type="submit" class="btn-submit">Chỉnh sửa</button>
        <button type="reset" class="btn-reset">
          <a style="text-decoration: none; color: white" href="/admin/brands"
            >Quay lại</a
          >
        </button>
      </div>
    </form>
  </div>
</div>
